# DeepSeek API key for PRONOI's decision-explanation route (src/app/api/deepseek/explain).
# Server-side only — never exposed to the client. If unset, the route falls
# back to a deterministic template explanation and the product still works.
DEEPSEEK_API_KEY=

# Postgres connection for PRONOI's persistent backend (see docs/PRONOI_BACKEND.md).
DATABASE_URL="postgresql://USER@localhost:5432/pronoi?schema=public"
